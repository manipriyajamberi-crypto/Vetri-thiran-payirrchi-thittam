            "image_path": image_path,
        }

    except Exception as exc:

        raise HTTPException(
            status_code=500,
            detail=str(exc),
        ) from exc


# ---------------------------------------
# PDF DOWNLOAD
# ---------------------------------------

@router.get(
    "/download"
)
async def download(
    pdf_path: str,
):

    prefix = "/static/exports/"

    if not pdf_path.startswith(
        prefix
    ):

        raise HTTPException(
            status_code=400,
            detail="Invalid export path.",
        )

    filename = pdf_path.removeprefix(
        prefix
    )

    file_path = (
        BASE_DIR
        / "static"
        / "exports"
        / filename
    )

    if (
        not file_path.exists()
        or file_path.suffix.lower() != ".pdf"
    ):

        raise HTTPException(
            status_code=404,
            detail="PDF not found.",
        )

    return FileResponse(
        path=file_path,
        media_type="application/pdf",
        filename=file_path.name,
    )


